# Copy to .env and fill in. NEVER commit .env or the data/ directory.
# Precedence: real environment > .env > config.yaml values.

# --- Required for letter drafting: any OpenAI-compatible LLM gateway ---
LITELLM_API_KEY=

# --- Optional overrides (defaults live in config.yaml) ---
# LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# LLM_MODEL=glm-5.3-flash

# --- Optional: Telegram alerts (flip telegram.enabled: true in config.yaml) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Upwork: NO credentials here ---
# Upwork uses per-user interactive OAuth. Run once on your own machine:
#   python3 upwork_login.py
# It registers a dynamic OAuth client, opens your browser to log in, and
# writes data/upwork_tokens.json (gitignored). If the app runs on a server,
# scp that file to <server>/data/upwork_tokens.json (chmod 600).
# Access tokens auto-refresh; re-run the login only if refresh is revoked.
